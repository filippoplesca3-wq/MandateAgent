# ---------------------------------------------------------------------------
# PayPal sandbox credentials
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# These are SANDBOX credentials only. Never commit real credentials.
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# Optional: map PayPal's merchant identifiers (merchant id or account email) to
# the merchant name a mandate uses. Required when a live capture must match an
# allowlist entry such as "acme-supplies".
# PAYPAL_MERCHANT_ALIASES=ABC123XYZ=acme-supplies,business@example.com=acme-supplies

# With sandbox credentials present, the UI exposes a "Live sandbox payment"
# panel: the payer approves in the browser and the server captures the order
# through the mandate guard.

# Optional: verify inbound PayPal webhooks. Add a webhook in the PayPal app
# pointing at https://<your-host>/api/webhooks/paypal, subscribe to
# PAYMENT.CAPTURE.COMPLETED, then paste its id here. Without this the endpoint
# answers 503 rather than accepting unverified deliveries.
# PAYPAL_WEBHOOK_ID=your_webhook_id

# Optional: run the real agent against local PayPal tool doubles even when
# credentials are present. Nothing reaches PayPal; no sandbox order moves.
# PAYPAL_MODE=simulated

# ---------------------------------------------------------------------------
# LLM provider (optional)
# The mandate core, policy engine and trust scoring run without any LLM.
# An API key is only required to drive the autonomous shopping agent.
# Free key: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Optional: pin one model instead of the fallback list.
# On the free tier the daily cap is counted per model, so the fallback matters.
# AGENT_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# Mandate signing key
# Any long random string. Rotating it invalidates every issued mandate.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
MANDATE_SIGNING_KEY=change_me_to_a_long_random_string

# ---------------------------------------------------------------------------
# Replay (hosted demo)
# Serve a recorded run instead of calling any API. Needs no other credentials,
# and makes every write endpoint read-only.
# ---------------------------------------------------------------------------
# REPLAY_FILE=replays/demo-run.json
# REPLAY_FRAME_MS=1200

# Server port (default 3001)
PORT=3001
