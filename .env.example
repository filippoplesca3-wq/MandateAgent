# ---------------------------------------------------------------------------
# PayPal sandbox credentials
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# These are SANDBOX credentials only. Never commit real credentials.
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# Optional: the merchant id used when the toolkit creates an order. The demo
# defaults to a local simulated merchant when this is absent.
# PAYPAL_MERCHANT_ID=MERCHANT123456789

# Optional: map PayPal's merchant identifiers (merchant id or account email) to
# the merchant name a mandate uses. Required when a live capture must match an
# allowlist entry such as "acme-supplies".
# PAYPAL_MERCHANT_ALIASES=ABC123XYZ=acme-supplies,business@example.com=acme-supplies

# With sandbox credentials present, the UI exposes a "Live sandbox payment"
# panel: the payer approves in the browser and the server captures the order
# through the mandate guard.

# Optional: verify inbound PayPal webhooks. Add a webhook in the PayPal app
# pointing at https://<your-host>/api/webhooks/paypal, subscribe to
# PAYMENT.CAPTURE.COMPLETED, then paste its id here. Without this the endpoint
# answers 503 rather than accepting unverified deliveries.
# PAYPAL_WEBHOOK_ID=your_webhook_id

# Optional: run the real agent against local PayPal tool doubles even when
# credentials are present. Nothing reaches PayPal; no sandbox order moves.
# PAYPAL_MODE=simulated

# ---------------------------------------------------------------------------
# LLM provider (optional)
# The mandate core, policy engine and trust scoring run without any LLM.
# An API key is only required to drive the autonomous shopping agent.
# Free key: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Optional: pin one model instead of the fallback list.
# On the free tier the daily cap is counted per model, so the fallback matters.
# AGENT_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# Mandate signing key
# Any long random string. It is derived into an Ed25519 key pair; the public
# half is published at /api/mandate/public-key. Rotating it invalidates every
# issued mandate. Set it in production so the public key is stable across
# restarts; on Render the blueprint generates it. In replay mode the server
# still issues a fresh demo mandate on each boot, so mandate ids are ephemeral.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
MANDATE_SIGNING_KEY=change_me_to_a_long_random_string

# ---------------------------------------------------------------------------
# API security
# ADMIN_TOKEN is required by the administrative routes (issue, revoke,
# approve). Without it they fail closed. The agent endpoints never receive it,
# so the agent cannot approve its own payments. It is not needed for the
# read-only replay demo: writes there are refused with 409 by design.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
ADMIN_TOKEN=change_me_to_a_long_random_string

# Comma-separated exact origins allowed to call the API from a browser. The
# hosted demo is same-origin, so this can stay empty.
# ALLOWED_ORIGINS=https://your-demo.onrender.com

# Requests per minute per IP on /api/agent/run and /api/evaluate (default 30).
# RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------------
# Persistence (optional)
# STORE_BACKEND=sqlite keeps mandates, ledger, approvals and reservations in a
# SQLite file across restarts. Uses Node's built-in node:sqlite (Node 22.5+),
# so there is no native dependency to install.
# ---------------------------------------------------------------------------
# STORE_BACKEND=sqlite
# STORE_DB=data/agent-mandate.sqlite

# ---------------------------------------------------------------------------
# Live demo (optional, hosted)
# The hosted demo serves a recording by default. Setting DEMO_LIVE=1 turns on
# "Chat live with Gemini": a multi-turn conversation against simulated PayPal,
# in a throwaway store, capped globally per day and per visitor. The key stays
# on the server and is never sent to the browser. PayPal is always simulated in
# this path, so the worst case is Gemini quota, not money.
# ---------------------------------------------------------------------------
# DEMO_LIVE=1
# DEMO_LIVE_DAILY_CAP=10
# DEMO_LIVE_COOLDOWN_SECONDS=120
# DEMO_CHAT_MAX_TURNS=4

# ---------------------------------------------------------------------------
# Replay (hosted demo)
# Serve a recorded run instead of calling any API. Needs no other credentials,
# and makes every write endpoint read-only.
# ---------------------------------------------------------------------------
# REPLAY_FILE=replays/demo-run.json
# REPLAY_FRAME_MS=1200
# REPLAY_OUT=replays/demo-run.json

# Server port (default 3001)
PORT=3001
