# ---------------------------------------------------------------------------
# PayPal sandbox credentials
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# These are SANDBOX credentials only. Never commit real credentials.
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# ---------------------------------------------------------------------------
# LLM provider (optional)
# The mandate core, policy engine and trust scoring run without any LLM.
# An API key is only required to drive the autonomous shopping agent.
# Free key: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Optional: pin one model instead of the fallback list.
# On the free tier the daily cap is counted per model, so the fallback matters.
# AGENT_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# Mandate signing key
# Any long random string. Rotating it invalidates every issued mandate.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
MANDATE_SIGNING_KEY=change_me_to_a_long_random_string

# Server port (default 3001)
PORT=3001
